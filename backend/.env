PGPORT=5432
PGUSER=username
PGPASSWORD=password
PGDATABASE=dbname
PGSSLMODE=prefer
PGCHANNELBINDING=prefer

# Option 2: Or use a single DATABASE_URL (if individual vars not set)
DATABASE_URL=postgresql://username:password@localhost:5432/dbname